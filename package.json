{
  "name": "vue-vrm",
  "version": "0.2.0",
  "description": "Vrm viewer component for Vue 3.",
  "keywords": [
    "vrm",
    "vrma",
    "three.js",
    "vue",
    "animation",
    "vue-component"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/vue-vrm",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vue-vrm.git"
  },
  "bugs": {
    "url": "https://github.com/logue/vue-vrm/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "rslib --watch",
    "dev:docs": "rsbuild",
    "preview": "rsbuild preview",
    "lint": "run-s lint:*",
    "lint:check": "biome check --write",
    "lint:rslint": "rslint .",
    "lint:format": "prettier --write .",
    "build": "run-s build:lib build:dts",
    "build:docs": "rsbuild build",
    "build:lib": "rslib build",
    "build:dts": "dts-bundle-generator --project ./tsconfig.app.json --no-banner -o dist/index.d.ts src/lib.ts",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": ">=3.5.4",
    "@pixiv/three-vrm-animation": ">=3.5.4",
    "@pixiv/three-vrm-materials-mtoon": ">=3.5.4",
    "three": ">=0.185.1",
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "@pixiv/three-vrm-materials-mtoon": "^3.5.4",
    "@rsbuild/core": "^2.1.4",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rslib/core": "^0.23.1",
    "@rslint/core": "^0.6.4",
    "@rstest/adapter-rsbuild": "^0.10.6",
    "@rstest/core": "^0.10.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/node": "^26.1.0",
    "@types/three": "^0.185.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.3.0",
    "dts-bundle-generator": "^9.5.1",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.6"
  }
}
