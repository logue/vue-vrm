{
  "name": "vue-vrm",
  "version": "0.0.0",
  "description": "Vrm viewer component for Vue 3.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/vue-vrm",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vue-vrm.git"
  },
  "bugs": {
    "url": "https://github.com/logue/vue-vrm/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "rsbuild build",
    "check": "biome check --write",
    "dev": "rsbuild --open",
    "format": "biome format --write",
    "lint": "eslint .",
    "lint:oxlint": "oxlint . --fix",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": ">=3.5.0",
    "@pixiv/three-vrm-animation": ">=3.5.0",
    "three": ">=0.184.0",
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@pixiv/three-vrm": ">=3.5.0",
    "@pixiv/three-vrm-animation": ">=3.5.0",
    "@rsbuild/core": "^2.0.3",
    "@rsbuild/plugin-vue": "^1.2.7",
    "@rstest/adapter-rsbuild": "^0.2.6",
    "@rstest/core": "^0.9.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/three": ">=0.184.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.2.1",
    "eslint-plugin-oxlint": "^1.62.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "three": ">=0.184.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vue": "^3.5.33"
  }
}
