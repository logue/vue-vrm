{
  "name": "vue-vrm",
  "version": "0.4.0",
  "description": "Vrm viewer component for Vue 3 / WebComponents.",
  "keywords": [
    "vrm",
    "vrma",
    "three.js",
    "vue",
    "animation",
    "vue-component",
    "web-components"
  ],
  "homepage": "https://github.com/logue/vue-vrm",
  "bugs": {
    "url": "https://github.com/logue/vue-vrm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vue-vrm.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": [
    "./dist/wc-auto.es.js",
    "./dist/wc-auto.umd.js",
    "./src/wc-auto.ts",
    "./src/helpers/vue-flags.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./wc": {
      "types": "./dist/wc.d.ts",
      "import": "./dist/wc.es.js",
      "default": "./dist/wc.es.js"
    },
    "./wc-auto": {
      "types": "./dist/wc-auto.d.ts",
      "import": "./dist/wc-auto.es.js",
      "default": "./dist/wc-auto.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./wc/umd": {
      "default": "./dist/wc.umd.js"
    },
    "./wc-auto/umd": {
      "default": "./dist/wc-auto.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rs dev --open",
    "dev:docs": "pnpm run build:demo && rs doc",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf dist docs src-docs/public/demo",
    "clean:hard": "rimraf .rstack/cache .rstack/.rsdoctor demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:demo": "rs build",
    "build:docs": "run-s build:demo build:rspress",
    "build:rspress": "rs doc build",
    "preview": "rs preview",
    "preview:docs": "rs doc preview",
    "analyze": "cross-env RSDOCTOR=true rs lib",
    "build-only": "rs lib",
    "type-check": "vize check --tsconfig tsconfig.rslib.json",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "rs hooks"
  },
  "devDependencies": {
    "@carbon/colors": "^11.62.0",
    "@carbon/icons": "^11.92.0",
    "@carbon/styles": "^1.120.0",
    "@carbon/type": "^11.71.0",
    "@carbon/web-components": "^2.68.0",
    "@pixiv/three-vrm": "^3.6.0",
    "@pixiv/three-vrm-animation": "^3.6.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/cli": "^2.0.4",
    "@rsdoctor/core": "^2.0.4",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rspress/core": "^2.1.5",
    "@rstest/adapter-rslib": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/three": "^0.187.0",
    "@types/webxr": "^0.5.24",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.1.0",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.9",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.1.0",
    "prettier-plugin-yaml": "^1.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "rstack": "^0.9.5",
    "taze": "^21.3.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vize": "^0.807.0"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": "^3.6.0",
    "@pixiv/three-vrm-animation": "^3.6.0",
    "three": ">=0.187.0",
    "vue": ">=3.5.0"
  },
  "packageManager": "pnpm@12.23.0"
}
